#!/bin/sh
# ===========================================================================
#  25-start-monitor.hook
# ---------------------------------------------------------------------------
#  Pika Backup's scheduled-backups daemon (pika-backup-monitor) needs:
#    - to be D-Bus-activatable (StartServiceByName(.Monitor));
#    - to start at login (the monitor polls schedules every 60 s);
#    - the UI to be D-Bus-activatable too, so the monitor can wake it when a
#      scheduled backup is due while the window is closed (.Api).
#
#  This hook installs the same per-user freedesktop files as the native
#  package, in the real host XDG dirs (HOST_XDG_*), NOT in the AppImage's
#  portable dirs:
#    ~/.local/share/dbus-1/services/<Monitor>.service
#    ~/.local/share/dbus-1/services/<Api>.service
#    ~/.config/autostart/<Monitor>.desktop
#
#  The autostart entry runs a small host-side wrapper. At login:
#    - AppImage missing -> remove autostart, wrapper, both services and the
#      private launcher symlinks (cleanup after deletion/rename);
#    - no enabled schedule -> exit without starting the daemon; the autostart
#      entry stays (cheap, no monitor process);
#    - schedule enabled -> exec the monitor.
#
#  App managers (AM/AppMan, etc.) install the AppImage under the program name
#  (e.g. "pika-backup"), and AppRun dispatches on the *invocation* name. The
#  service/autostart therefore use host symlinks named "pika-backup-monitor"
#  and "pika-backup" -> AppImage; AppRun selects the right binary regardless
#  of the AppImage file name.
#
#  This file is SOURCED by AppRun.sh: use `return`, never `exit`.
# ===========================================================================

# Real host dirs: HOST_XDG_* are set by the anylinux runtime and are not
# redirected by AppImage portable home/config mode.
_host_home="${HOST_HOME:-$HOME}"
_host_data="${HOST_XDG_DATA_HOME:-${XDG_DATA_HOME:-$_host_home/.local/share}}"
_host_config="${HOST_XDG_CONFIG_HOME:-${XDG_CONFIG_HOME:-$_host_home/.config}}"

_monitor_name="org.gnome.World.PikaBackup.Monitor"
_api_name="org.gnome.World.PikaBackup.Api"
_app_dir="$_host_data/pika-backup-appimage"
_link_dir="$_app_dir/bin"
_monitor_link="$_link_dir/pika-backup-monitor"
_app_link="$_link_dir/pika-backup"
_wrapper="$_app_dir/pika-backup-monitor-autostart"
_autostart="$_host_config/autostart/$_monitor_name.desktop"
_service_monitor="$_host_data/dbus-1/services/$_monitor_name.service"
_service_api="$_host_data/dbus-1/services/$_api_name.service"

_write_if_changed() {
	if [ -f "$1" ] && [ "$(cat "$1" 2>/dev/null)" = "$2" ]; then
		return 0
	fi
	mkdir -p "${1%/*}" 2>/dev/null || return 0
	printf '%s\n' "$2" > "$1" 2>/dev/null || :
}

_write_exec() {
	if [ -f "$1" ] && [ -x "$1" ] && [ "$(cat "$1" 2>/dev/null)" = "$2" ]; then
		return 0
	fi
	mkdir -p "${1%/*}" 2>/dev/null || return 0
	printf '%s\n' "$2" > "$1" 2>/dev/null || return 0
	chmod +x "$1" 2>/dev/null || :
}

_bus_reload() {
	if command -v busctl >/dev/null 2>&1; then
		busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
		  org.freedesktop.DBus ReloadConfig >/dev/null 2>&1 && return 0
	fi
	if command -v gdbus >/dev/null 2>&1; then
		gdbus call --session --dest org.freedesktop.DBus \
		  --object-path /org/freedesktop/DBus \
		  --method org.freedesktop.DBus.ReloadConfig >/dev/null 2>&1 && return 0
	fi
	if command -v dbus-send >/dev/null 2>&1; then
		dbus-send --session --type=method_call --dest=org.freedesktop.DBus \
		  /org/freedesktop/DBus org.freedesktop.DBus.ReloadConfig \
		  >/dev/null 2>&1 && return 0
	fi
	return 1
}

# Quote a path for an Exec= line when it contains whitespace.
_exec_path() {
	case "$1" in
		*[[:space:]]*) printf '"%s"' "$1" ;;
		*)             printf '%s' "$1" ;;
	esac
}

_install() {
	[ -n "$APPIMAGE" ] || return 0

	# Host symlinks: the names are what AppRun uses to pick the binary.
	mkdir -p "$_link_dir" 2>/dev/null || return 0
	ln -sfn "$APPIMAGE" "$_monitor_link" 2>/dev/null || :
	ln -sfn "$APPIMAGE" "$_app_link" 2>/dev/null || :

	# D-Bus activation files (always installed; cheap and idempotent).
	_monitor_exec=$(_exec_path "$_monitor_link")
	_app_exec=$(_exec_path "$_app_link")
	_write_if_changed "$_service_monitor" "[D-BUS Service]
Name=$_monitor_name
Exec=$_monitor_exec"
	_write_if_changed "$_service_api" "[D-BUS Service]
Name=$_api_name
Exec=$_app_exec --gapplication-service"
	# AppRun runs with `set -e`: a missing session bus (CI, headless)
	# must not abort the hook before the wrapper/autostart are written.
	_bus_reload || :

	# Quote paths for the generated shell wrapper.
	case "$APPIMAGE" in
		*\'*) _q_appimage="\"$APPIMAGE\"" ;;
		*)    _q_appimage="'$APPIMAGE'" ;;
	esac
	case "$_monitor_link" in
		*\'*) _q_monitor="\"$_monitor_link\"" ;;
		*)    _q_monitor="'$_monitor_link'" ;;
	esac
	case "$_wrapper" in
		*\'*) _q_self="\"$_wrapper\"" ;;
		*)    _q_self="'$_wrapper'" ;;
	esac
	case "$_autostart" in
		*\'*) _q_autostart="\"$_autostart\"" ;;
		*)    _q_autostart="'$_autostart'" ;;
	esac
	case "$_service_monitor" in
		*\'*) _q_service_monitor="\"$_service_monitor\"" ;;
		*)    _q_service_monitor="'$_service_monitor'" ;;
	esac
	case "$_service_api" in
		*\'*) _q_service_api="\"$_service_api\"" ;;
		*)    _q_service_api="'$_service_api'" ;;
	esac
	case "$_link_dir" in
		*\'*) _q_link_dir="\"$_link_dir\"" ;;
		*)    _q_link_dir="'$_link_dir'" ;;
	esac

	_write_exec "$_wrapper" "#!/bin/sh
# Auto-generated by the Pika Backup AppImage. Do not edit.
_self=$_q_self
_autostart=$_q_autostart
_service_monitor=$_q_service_monitor
_service_api=$_q_service_api
_link_dir=$_q_link_dir
_appimage=$_q_appimage
_monitor_link=$_q_monitor
_cfg=\"\${XDG_CONFIG_HOME:-\$HOME/.config}/pika-backup/backup.json\"

# Portable mode: the app reads its config from next to the AppImage.
for _d in \"\$_appimage.config\" \"\$_appimage.home/.config\"; do
	if [ -f \"\$_d/pika-backup/backup.json\" ]; then
		_cfg=\"\$_d/pika-backup/backup.json\"
		break
	fi
done

# The AppImage is gone (deleted or renamed by an update): remove our files.
if [ ! -e \"\$_appimage\" ]; then
	rm -f \"\$_autostart\" \"\$_service_monitor\" \"\$_service_api\"
	rm -rf \"\$_link_dir\"
	rm -f \"\$_self\"
	command -v busctl >/dev/null 2>&1 && busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ReloadConfig >/dev/null 2>&1
	exit 0
fi

# No enabled schedule: do not start the daemon; keep the autostart entry.
_enabled=
if [ -f \"\$_cfg\" ]; then
	_enabled=\$(sed 's/{/{\\n/g; s/}/\\n}/g' \"\$_cfg\" 2>/dev/null | awk '
	/\"schedule\"[ \\t]*:[ \\t]*\\{/ { insched=1; depth=0; next }
	insched {
		if (depth == 0 && \$0 ~ /\"enabled\"[ \\t]*:[ \\t]*true/) found=1
		depth += gsub(/\\{/,\"{\") - gsub(/\\}/,\"}\")
		if (depth < 0) insched=0
		next
	}
	END { if (found) print 1 }
')
fi
if [ \"\$_enabled\" != 1 ]; then
	exit 0
fi

# AppImage exists and a schedule is enabled: refresh the links and start.
mkdir -p \"\$_link_dir\" 2>/dev/null || :
ln -sfn \"\$_appimage\" \"\$_monitor_link\" 2>/dev/null || :
ln -sfn \"\$_appimage\" \"\$_link_dir/pika-backup\" 2>/dev/null || :
exec \"\$_monitor_link\""

	# XDG autostart entry (kept while the AppImage exists).
	case "$_wrapper" in
		*[[:space:]]*)
			_desktop_exec="\"$_wrapper\""
			_tryexec=""
			;;
		*)
			_desktop_exec="$_wrapper"
			_tryexec="TryExec=$_wrapper"
			;;
	esac
	if [ -n "$_tryexec" ]; then
		_desktop="[Desktop Entry]
Type=Application
Name=Pika Backup Monitor
Comment=Run scheduled backups for Pika Backup
Exec=$_desktop_exec
$_tryexec
Icon=org.gnome.World.PikaBackup
X-GNOME-Autostart-Delay=90
X-GNOME-UsesNotifications=true
NoDisplay=true"
	else
		_desktop="[Desktop Entry]
Type=Application
Name=Pika Backup Monitor
Comment=Run scheduled backups for Pika Backup
Exec=$_desktop_exec
Icon=org.gnome.World.PikaBackup
X-GNOME-Autostart-Delay=90
X-GNOME-UsesNotifications=true
NoDisplay=true"
	fi
	_write_if_changed "$_autostart" "$_desktop"

	# Remove the wrapper from the earlier (pre-B+) location.
	rm -f "$_host_home/.local/bin/pika-backup-monitor-autostart" 2>/dev/null || :
}

_install
