#!/bin/sh
# ===========================================================================
#  25-start-monitor.hook
# ---------------------------------------------------------------------------
#  Pika Backup's scheduled-backups daemon (pika-backup-monitor) is normally
#  started by the desktop session:
#    - XDG autostart: /etc/xdg/autostart/org.gnome.World.PikaBackup.Monitor.desktop
#      (installed unconditionally by the native package);
#    - D-Bus activation: /usr/share/dbus-1/services/...Monitor.service.
#
#  An AppImage can install neither system-wide. Two consequences, both fixed
#  here by writing into the user's home (the only place an AppImage may write):
#
#    A) ~/.local/share/dbus-1/services/org.gnome.World.PikaBackup.Monitor.service
#       makes the well-known name *activatable*. The GUI calls D-Bus
#       StartServiceByName when the user enables a schedule
#       (pika-backup/src/utils.rs -> background_permission) and when closing
#       the window during a running backup (pika-backup/src/app.rs), otherwise
#       it fails with ServiceUnknown "not activatable". This directory is
#       watched by the bus, but dbus-broker (Fedora) needs a ReloadConfig.
#       -> Written ALWAYS; it starts nothing by itself.
#
#    B) ~/.config/autostart/org.gnome.World.PikaBackup.Monitor.desktop
#       starts the daemon at login so *scheduled* backups run even if the GUI
#       is never opened. The official Flatpak only registers this when a
#       schedule is actually enabled (Background portal), so we do the same:
#       install it only if ~/.config/pika-backup/backup.json has a schedule
#       with "enabled": true, and remove it otherwise. No permanent daemon
#       when the user does not use scheduled backups.
#
#  Finally the daemon is started for the current session (once), which is
#  harmless and keeps the UI "active" without waiting for an activation.
#
#  NOTE: this file is SOURCED by AppRun.sh, therefore we use `return` and not
#  `exit` (an `exit` would terminate AppRun.sh and the app would never start).
# ===========================================================================

# Are we being launched *as* the daemon? (via the autostart entry
# "Exec=<AppImage> pika-backup-monitor", or directly as bin/pika-backup-monitor)
_is_monitor_launch() {
	case "${ARG0##*/}" in
		pika-backup-monitor) return 0 ;;
	esac
	case "$1" in
		pika-backup-monitor) return 0 ;;
	esac
	return 1
}

# Write $2 to $1 only if the content differs (avoids bumping mtime every run).
_write_if_changed() {
	if [ -f "$1" ] && [ "$(cat "$1" 2>/dev/null)" = "$2" ]; then
		return 0
	fi
	mkdir -p "${1%/*}" 2>/dev/null || return 0
	printf '%s\n' "$2" > "$1" 2>/dev/null || :
}

# ---------------------------------------------------------------------------
#  Try every available way to (re)load the bus configuration, so a .service
#  written at runtime becomes activatable (dbus-broker requires this;
#  dbus-daemon picks it up by itself).
# ---------------------------------------------------------------------------
_bus_reload() {
	if command -v busctl >/dev/null 2>&1; then
		busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
		  org.freedesktop.DBus ReloadConfig >/dev/null 2>&1 && return 0
	fi
	if command -v gdbus >/dev/null 2>&1; then
		gdbus call --session --dest org.freedesktop.DBus \
		  --object-path /org/freedesktop/DBus \
		  --method org.freedesktop.DBus.ReloadConfig >/dev/null 2>&1 && return 0
	fi
	if command -v dbus-send >/dev/null 2>&1; then
		dbus-send --session --type=method_call --dest=org.freedesktop.DBus \
		  /org/freedesktop/DBus org.freedesktop.DBus.ReloadConfig \
		  >/dev/null 2>&1 && return 0
	fi
	if command -v systemctl >/dev/null 2>&1; then
		systemctl --user daemon-reload >/dev/null 2>&1 && return 0
	fi
	return 1
}

# ---------------------------------------------------------------------------
#  Does the user have at least one backup with an enabled schedule?
#  Reads ~/.config/pika-backup/backup.json (a JSON array of backups, each with
#  a "schedule": { "enabled": bool }). Uses the bundled python3 (guaranteed by
#  DEPLOY_PYTHON=1); if it is unavailable, do NOT enable autostart (safe:
#  scheduled backups still work while the GUI runs, and can be triggered).
# ---------------------------------------------------------------------------
_schedule_enabled() {
	_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/pika-backup/backup.json"
	[ -f "$_cfg" ] || return 1
	command -v python3 >/dev/null 2>&1 || return 1
	python3 - "$_cfg" <<-'PY' 2>/dev/null
	import json, sys
	try:
	    with open(sys.argv[1]) as f:
	        data = json.load(f)
	except Exception:
	    sys.exit(1)
	backups = data if isinstance(data, list) else [data]
	for b in backups:
	    if isinstance(b, dict) and b.get("schedule", {}).get("enabled") is True:
	        sys.exit(0)
	sys.exit(1)
	PY
}

# ---------------------------------------------------------------------------
#  Write the D-Bus activation file (always) and the autostart entry (only if a
#  schedule is enabled; removed otherwise), then reload the bus.
# ---------------------------------------------------------------------------
_install_entries() {
	# Only meaningful for a real (non-extracted) AppImage: we need its path.
	[ -n "$APPIMAGE" ] || return 0

	# Quote the path for the Exec key if it contains spaces.
	case "$APPIMAGE" in
		*[[:space:]]*) _exec="\"$APPIMAGE\" pika-backup-monitor" ;;
		*)             _exec="$APPIMAGE pika-backup-monitor" ;;
	esac

	# 1) D-Bus activation (always): makes StartServiceByName succeed.
	_write_if_changed \
	  "${XDG_DATA_HOME:-$HOME/.local/share}/dbus-1/services/org.gnome.World.PikaBackup.Monitor.service" \
	  "[D-BUS Service]
Name=org.gnome.World.PikaBackup.Monitor
Exec=$_exec"
	_bus_reload

	# 2) XDG autostart (only with an enabled schedule), matching the Flatpak.
	_autostart_file="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/org.gnome.World.PikaBackup.Monitor.desktop"
	if _schedule_enabled; then
		_write_if_changed "$_autostart_file" \
		  "[Desktop Entry]
Type=Application
Name=Pika Backup Monitor
Comment=Run scheduled backups for Pika Backup
Exec=$_exec
Icon=org.gnome.World.PikaBackup
X-GNOME-Autostart-Delay=90
X-GNOME-UsesNotifications=true
NoDisplay=true"
	else
		# No scheduled backup -> do not keep a daemon running at login.
		rm -f "$_autostart_file" 2>/dev/null || :
	fi
}

# When the daemon itself is launched, just refresh the entries and let
# AppRun.sh run the daemon (do NOT start a second copy here).
if _is_monitor_launch "$1"; then
	_install_entries
	return 0
fi

# Register the activation file (and, if needed, the autostart entry).
_install_entries

# Start the daemon now, once per session: skip if the recorded process lives.
_lock="${XDG_RUNTIME_DIR:-/tmp}/pika-backup-monitor.lock"
if [ -r "$_lock" ] && kill -0 "$(cat "$_lock" 2>/dev/null)" 2>/dev/null; then
	return 0
fi

pika-backup-monitor >/dev/null 2>&1 &
echo "$!" > "$_lock" 2>/dev/null || :
